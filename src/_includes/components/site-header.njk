          </svg>
      </a>

      <nav aria-label="Primary Navigation">
        <button class="navigation__toggle" aria-expanded="false" aria-controls="main-menu">
          <span class="hamburger" aria-hidden="true"></span>
          <span class="toggle-text">Menu</span>
        </button>

        <ul class="navigation__menu invert-button-style">
          {% for item in navigation.menuItems %}
            <li class="navigation__menu-item {% if item.subItems %} has-submenu{% endif %}">
              <a class="{% if item.isButton %}link-button link-button--outline{% endif %} {% if item.url == '#' %}navigation__menu--category{% endif %}" href="{{ item.url }}" {% if item.subItems %}aria-haspopup="true" aria-expanded="false"{% endif %}>
                {{ item.text }}
              </a>

              {% if item.subItems %}
                <ul class="navigation__submenu">
                  {% for subItem in item.subItems %}
                    <li class="navigation__submenu-item">
                      <a href="{{ subItem.url }}">{{ subItem.text }}</a>
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </nav>

    </div>
  </div>
</header>